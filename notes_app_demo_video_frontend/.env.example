# Remotion configuration for Studio
# Ensure the app binds to port 3000 for the platform proxy
REMOTION_PORT=3000

# Set a healthcheck path that returns 200 to help avoid proxy 502
REMOTION_HEALTHCHECK_PATH=/health

# Optional tuning
# REMOTION_LOG_LEVEL=info
# REMOTION_TRUST_PROXY=true
# REMOTION_ENABLE_SOURCE_MAPS=false

# Not used directly by this app, but reserved for future integration
# REMOTION_API_BASE=
# REMOTION_BACKEND_URL=
# REMOTION_FRONTEND_URL=
# REMOTION_WS_URL=
# REMOTION_NODE_ENV=production
# REMOTION_NEXT_TELEMETRY_DISABLED=1
# REMOTION_FEATURE_FLAGS=
# REMOTION_EXPERIMENTS_ENABLED=
